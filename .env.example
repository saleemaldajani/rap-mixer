# Model identifiers are configurable; this public edition never reads server API keys.
DEFAULT_OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
DEFAULT_OPENAI_MODEL=gpt-5.4-mini
DEFAULT_GEMINI_MODEL=gemini-3.5-flash
DEFAULT_ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Optional local Ollama endpoint.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_SEMANTIC_MODEL=llama3.2

# Local development defaults. Railway supplies PORT and the Docker image binds publicly.
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
